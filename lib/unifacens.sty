% ---
% INICIO DAS CUSTOMIZACOES PARA O CENTRO UNIVERSITÁRIO FACENS.
% ---

% ---
% Variáveis
% ---

\newcommand{\cps}{\def \@cps}
\newcommand{\sedefatec}{\def \@sedefatec}
\newcommand{\fatec}{\def \@fatec}
\newcommand{\coordenadoria}{\def \@coordenadoria}
\newcommand{\integranteum}{\def \@integranteum}
\newcommand{\integrantedois}{\def \@integrantedois}
\newcommand{\subtitulo}{\def \@subtitulo}

% ---
% Inicialização das variáveis
% ---
\fatec{}
\sedefatec{}
\cps{}
\coordenadoria{}
\integranteum{}
\integrantedois{}
\subtitulo{}

% ---
% Imprimir as váriaveis
% ---
\newcommand{\imprimircps}{\@cps}
\newcommand{\imprimirsedefatec}{Faculdade de Tecnologia de \@sedefatec}
\newcommand{\imprimirfatec}{\@fatec}
\newcommand{\imprimirintegranteum}{\@integranteum}
\newcommand{\imprimirintegrantedois}{\@integrantedois}
\newcommand{\imprimirsubtitulo}{\@subtitulo}
\newcommand{\imprimirfolhadeaprovacao}{}
% ---
% Re-adaptações de capa e folha de rosto
% ---

% Capa
\renewcommand{\imprimircapa}{
    \begin{titlingpage}
        \begin{center}
            % Todos elementos da capa devem estar em negrito
            \bfseries
           
            \Large{\MakeUppercase{\imprimircps}}\\
            \vspace*{1cm}
            \Large{\MakeUppercase{\imprimirsedefatec}}\\
            \Large{\MakeUppercase{\imprimirfatec}}
            \vspace*{5cm}

            \large{\MakeUppercase{\imprimirintegranteum}}\par
            \large{\MakeUppercase{\imprimirintegrantedois}}
            
            \vspace*{5cm}

            \ifx\@subtitulo\empty
                \large{\MakeUppercase{\imprimirtitulo}}
            \else
                \large{\MakeUppercase{\imprimirtitulo}: \imprimirsubtitulo}
            \fi
            
            \vfill
            \large\imprimirlocal\par
            \large\imprimirdata
        \end{center}
    \end{titlingpage}
}

% Folha de rosto
\renewcommand{\folhaderostocontent}{
    \begin{center}
        \large{\textbf{\MakeUppercase{\imprimirintegranteum}}}\par
        \large{\textbf{\MakeUppercase{\imprimirintegrantedois}}}

        \vspace*{5cm}

        \ifx\@subtitulo\empty
            \large{\textbf{\MakeUppercase{\imprimirtitulo}}}    
        \else
            \large{\textbf{\MakeUppercase{\imprimirtitulo}: \imprimirsubtitulo}}
        \fi

        \vspace*{5cm}

        %Adiciona o espaço da margem
        \hspace*{8cm}
        \begin{minipage}{8cm}
            \begin{SingleSpace}
                \small\imprimirpreambulo
            \end{SingleSpace}
        \end{minipage}

        \vfill
        \large{\textbf\imprimirlocal}\par
        \large{\textbf\imprimirdata}
    \end{center}
}
% =================================================================
% 1. Comandos para os dois autores
% =================================================================

% =================================================================
% 2. Redefinição do \imprimirfolhadeaprovacao no .sty
% =================================================================
\makeatletter
\renewcommand{\imprimirfolhadeaprovacao}{
	\begin{folhadeaprovacao}
		\begin{center}
			% Autores
			{\bfseries\Large \MakeUppercase{\imprimirintegranteum}}\\[0.3cm]
			{\bfseries\Large \MakeUppercase{\imprimirintegrantedois}}
			
			\vfill
			
			% Título e Subtítulo
			{\bfseries\Large \MakeUppercase{\imprimirtitulo}%
				\abntex@ifnotempty{\imprimirsubtitulo}{: {\imprimirsubtitulo}}}
			
			\vfill
			
			% Preâmbulo (Recuado)
			\hspace*{0.45\textwidth}
			\begin{minipage}{0.5\textwidth}
				\small
				\imprimirpreambulo
			\end{minipage}
			
			\vspace*{2cm}
		\end{center}
		
		% Data de aprovação (Alinhado à esquerda)
		\noindent\textbf{Aprovado em: } \underline{\hspace{10cm}}
		
		\vfill
		\centering
		\textbf{Banca Examinadora}
		\vspace{1cm}
		% Assinaturas da banca
		\begin{center}
			\begin{minipage}{0.75\textwidth}
				\centering
				
				\rule{9cm}{0.4pt}\\[0.1cm]
				{\small Nome do orientador / titulação / IES}\\[1.2cm]
				
				\rule{9cm}{0.4pt}\\[0.1cm]
				{\small Nome do convidado / titulação / IES}\\[1.2cm]
				
				\rule{9cm}{0.4pt}\\[0.1cm]
				{\small Nome do convidado / titulação / IES}
			\end{minipage}
		\end{center}
	\end{folhadeaprovacao}
}
\makeatother

